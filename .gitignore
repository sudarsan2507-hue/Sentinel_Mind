# Secrets -- never commit. A leaked key gets scraped within minutes.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Coverage data -- machine-local, regenerated on every run
.coverage
.coverage.*
htmlcov/
coverage.xml

# Recorded traces may contain real pipeline inputs/outputs
traces/
# Saved agent runs (evals/run_agent_suite.py) -- same reason: they hold the agent's real tool inputs and outputs
runs/

# Accumulated failure memory -- same reason as traces/: it stores the monitored
# agent's real tool calls, and it is machine-local state, not source.
knowledge/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude skills -- local tooling, never committed
.claude/skills/
.agents/
