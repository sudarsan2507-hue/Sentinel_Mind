# TEMPLATE ONLY -- this file IS committed. Never put a real key here.
# Copy it to .env (which is gitignored) and fill that in instead.
#
#   copy .env.example .env

# Groq API key -- get one free at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Optional: override the meta-agent model.
# Check the live list at console.groq.com -- Groq's lineup changes.
# SENTINEL_MODEL=openai/gpt-oss-120b
# SENTINEL_AGENT_MODEL=openai/gpt-oss-20b

# Optional (gpt-oss only): low | medium | high | default. Medium measured best.
# SENTINEL_REASONING_EFFORT=medium

# Optional: ANOMALY verdicts below this confidence are downgraded to WARN.
# SENTINEL_CONFIDENCE_THRESHOLD=0.0
